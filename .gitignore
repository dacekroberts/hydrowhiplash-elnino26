# data is downloaded by scripts, never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# large outputs
*.nc
*.zarr/
*.zip

# python / jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# secrets
.cdsapirc
.env

# OS / editor
.DS_Store
.vscode/

# daily-log exports are regenerated on demand
logs/export/

# quarto build output
site/_site/
# the built site staged for upload (scripts/deploy_site.py)
dist/
site/.quarto/
# offline copy of the pinned inputs (src.pin_inputs --copy)
pinned_inputs_copy/
/handoff_cloudflare-setup_reference.md
# private: the V1 retrospective (master of the owner's private page)
/docs/retrospective_v1.md
# wrangler's local cache (holds the Cloudflare account ID)
.wrangler/
# the Motion handoff folder (scripts/build_motion_handoff.py) is committed as
# sent, except the private sample dashboard (owner, 2026-10-13)
/motion_handoff/storyboard.html
# internal handoff note for a Cloudflare session (owner, 2026-10-13)
/docs/handoff_link_preview_card.md

# Exports from the Motion chat, dropped here as they arrive. Not committed:
# scripts/prepare_film.py writes the served copy to results/film/ (D109).
/visuals/motion/*
